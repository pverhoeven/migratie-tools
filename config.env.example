# Kopieer naar config.env en pas aan. config.env staat in .gitignore.

# --- GitLab (alleen nodig voor run.sh) ---
GITLAB_TOKEN=
GITLAB_GROUP=mijn-groep
# Alleen bij self-hosted GitLab:
# GITLAB_BASE_URL=https://gitlab.example.com
CONCURRENT=4

# --- cruft-update ---
# Laat leeg voor de laatste template-versie, of pin een tag/commit:
# TEMPLATE_VERSION=v1.4.0

# --- openrewrite ---
REWRITE_PLUGIN_VERSION=
# Controleer de exacte receptnaam in de OpenRewrite-documentatie:
REWRITE_RECIPES=
# bv. org.openrewrite.recipe:rewrite-spring:LATEST
REWRITE_RECIPE_ARTIFACTS=
# Optioneel centrale recepten-config (absoluut pad):
# REWRITE_CONFIG=/pad/naar/rewrite.yml
# REWRITE_GOAL=dryRun   # alleen laten zien wat er zou veranderen
#                       # (patch in de output, lokaal ook in work/<naam>.rewrite.patch)

# --- verify ---
# MVN_VERIFY_ARGS=-DskipITs
