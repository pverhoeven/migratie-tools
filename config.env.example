# Kopieer naar config.env en pas aan. config.env staat in .gitignore.
# Wat een migratie doet (versies, recepten) staat niet hier maar in migraties/<naam>.env.

# --- GitLab (alleen nodig voor run.sh) ---
GITLAB_TOKEN=
GITLAB_GROUP=mijn-groep
# Alleen bij self-hosted GitLab:
# GITLAB_BASE_URL=https://gitlab.example.com
CONCURRENT=4
# Extra opties voor curl (de GitLab-API). Op Windows (Git Bash) achter een bedrijfsnetwerk
# geeft curl soms CRYPT_E_REVOCATION_OFFLINE: de intrekkingscontrole van het certificaat
# kan zijn server niet bereiken. Dan helpt:
# CURL_OPTS=--ssl-revoke-best-effort

# Repo's in de groep die nooit een service zijn (bv. libraries), gescheiden door spaties.
# Een naam sluit die repo in elke (sub)groep uit, een pad (groep/repo) alleen die ene.
# UITSLUITLIJST="gedeelde-lib infra-config"

# Begin van de branchnaam van een migratie (standaard migratie/), bv. als jullie Jenkins
# alleen branches met een bepaald begin bouwt. Geldt ook voor cruft-zet.sh.
# BRANCH_PREFIX=feature/

# --- Eigen migraties en recepten (optioneel) ---
# Bv. uit een interne repo van je organisatie, naast die van migratie-tools zelf.
# Een relatief pad geldt vanaf deze map.
# MIGRATIES_MAP=/pad/naar/intern/migraties      # migratiebestanden; een naam wordt eerst hier gezocht
# RECEPTEN_MAP=/pad/naar/intern/recepten        # Maven-module met recepten (zelfde rewrite-recipe-bom)

# --- Maven ---
# MVN_ARGS=            # extra argumenten bij het draaien van een recept
# MVN_VERIFY_ARGS=-DskipITs

# --- IntelliJ (verschil.sh --intellij) ---
# Het commando van IntelliJ, als 'idea' (of idea.cmd, idea64.exe) niet in het PATH staat:
# IDEA_CMD="/Applications/IntelliJ IDEA.app/Contents/MacOS/idea"
# IDEA_CMD="/c/Program Files/JetBrains/IntelliJ IDEA/bin/idea64.exe"

# --- cruft ---
# Python van cruft, als die niet uit de 'cruft'-executable af te leiden is:
# CRUFT_PYTHON=/pad/naar/venv/bin/python
