# Voorbeeldmigratie: de gedeelde jar komt voortaan via een init container, voor alle
# services die hem gebruiken. Het template krijgt de flag gedeelde_jar (init container,
# volume, extraClasspath in jib); het recept zet de dependency op provided.
ALLEEN_MET_DEPENDENCY=gedeelde-jar
CRUFT_UPDATE=ja
CRUFT_ZET='gedeelde_jar=true'
RECEPT=local.migratietools.GedeeldeJarProvided
PR_TITEL='feat: gedeelde jar via een init container'
