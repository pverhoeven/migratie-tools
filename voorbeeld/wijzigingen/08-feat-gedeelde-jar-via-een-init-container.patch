diff --git a/hooks/post_gen_project.py b/hooks/post_gen_project.py
new file mode 100644
index 0000000..b2d85a0
--- /dev/null
+++ b/hooks/post_gen_project.py
@@ -0,0 +1,7 @@
+"""Haalt onderdelen weg die bij deze service niet horen, zodat een service geen
+ongebruikte bestanden krijgt. Draait alleen bij het genereren; in de services staat niets
+van deze logica."""
+import os
+
+if not {{ cookiecutter.gedeelde_jar }}:
+    os.remove(os.path.join("chart", "templates", "_gedeelde-jar.tpl"))
diff --git a/{{cookiecutter.project_slug}}/chart/templates/_gedeelde-jar.tpl b/{{cookiecutter.project_slug}}/chart/templates/_gedeelde-jar.tpl
new file mode 100644
index 0000000..10a5704
--- /dev/null
+++ b/{{cookiecutter.project_slug}}/chart/templates/_gedeelde-jar.tpl
@@ -0,0 +1,22 @@
+{{- /* Gedeelde jar: een init container kopieert de jar uit een eigen image naar een
+       gedeeld volume; de app vindt hem daar via jib's extraClasspath (/gedeeld/*). */ -}}
+
+{{- define "gedeeldeJar.initContainer" -}}
+- name: gedeelde-jar
+  image: "{{ .Values.gedeeldeJar.image }}:{{ .Values.gedeeldeJar.tag }}"
+  command: ["sh", "-c", "cp /jar/*.jar /gedeeld/"]
+  volumeMounts:
+    - name: gedeelde-jar
+      mountPath: /gedeeld
+{{- end -}}
+
+{{- define "gedeeldeJar.volumeMount" -}}
+- name: gedeelde-jar
+  mountPath: /gedeeld
+  readOnly: true
+{{- end -}}
+
+{{- define "gedeeldeJar.volume" -}}
+- name: gedeelde-jar
+  emptyDir: {}
+{{- end -}}
