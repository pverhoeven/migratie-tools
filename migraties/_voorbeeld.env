# Sjabloon voor een migratiebestand. Kopieer naar migraties/<naam>.env en haal weg wat je
# niet nodig hebt. Bestanden die met _ beginnen zijn geen migratie. De inhoud komt in de
# beschrijving van elke PR.

# Welke services meedoen (optioneel). Zonder deze regel: alle services in de groep.
# Met deze regel: alleen services met deze dependency (artifactId) in een pom.xml; de rest
# krijgt "Niet van toepassing".
# ALLEEN_MET_DEPENDENCY=gedeelde-jar

# Wat er gebeurt (minstens één, in deze volgorde):
# 1. Het template bijwerken naar de nieuwste stand (zoals cruft update).
CRUFT_UPDATE=ja
# 2. Een of meer template-variabelen omzetten (zoals cruft-zet.sh), gescheiden door spaties.
# CRUFT_ZET='gedeelde_jar=true'
# 3. Eén OpenRewrite-recept uit recepten/ (een test is aan te raden).
# RECEPT=local.migratietools.WekelijkseOpschoning
# 4. Dependency-versies ophogen, bv. bij een kwetsbaarheid (groupId:artifactId:versie,
#    gescheiden door spaties). Direct en indirect; alleen waar de versie lager is.
# DEPENDENCY_VERSIE='org.apache.tomcat.embed:tomcat-embed-core:10.1.61'

# Automatisch mergen: standaard maakt run.sh --go de MR's aan met "merge when pipeline
# succeeds", dus een groene MR gaat door naar de default branch en een rode niet.
# Goedkeuringsregels in GitLab gelden gewoon; zet in de projecten "Pipelines must succeed"
# aan. Wil je de MR's eerst reviewen (bv. een grote cruft update), zet het dan uit:
# AUTOMATISCH_MERGEN=nee

# Branch en PR-titel (optioneel). Standaard migratie/<naam> (het begin is in te stellen
# met BRANCH_PREFIX in config.env) en chore(migratie): <naam>.
# BRANCH=migratie/voorbeeld
# PR_TITEL='chore(migratie): voorbeeld'
