# Voorbeeld van een migratiebestand (bestanden die met _ beginnen zijn geen migratie).
# Kopieer naar migraties/<naam>.env; <naam> wordt de branch migratie/<naam>.
# Alles vastpinnen: geen LATEST, main of "laatste versie".

# Template-update naar deze template-versie (tag):
TEMPLATE_VERSION=v1.4.0

# En/of één OpenRewrite-recept:
# RECEPT=org.openrewrite.java.spring.boot3.UpgradeSpringBoot_3_5
# REWRITE_PLUGIN_VERSION=
# REWRITE_RECIPE_ARTIFACTS=org.openrewrite.recipe:rewrite-spring:<versie>
